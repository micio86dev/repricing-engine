# AI Quality Gate
GROQ_API_KEY=gsk_xxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Matching thresholds
EXACT_ID_MIN_CONFIDENCE=0.95
SKU_BRAND_MIN_CONFIDENCE=0.80
SEMANTIC_MIN_CONFIDENCE=0.60
AI_GATE_MIN_CONFIDENCE=0.75

# Embedding model (runs locally on CPU — ~90MB download on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --------------------------------------------------------------------------- #
# Source fetching (opt-in: CLI --fetch). Discovers more competitor URLs.
# --------------------------------------------------------------------------- #
# SearXNG is the primary, free, self-hosted metasearch provider. Run one with:
#   docker run --rm -d -p 8888:8080 searxng/searxng
# then set the base URL below (leave empty to disable SearXNG).
SEARXNG_BASE_URL=
SEARXNG_ENABLED=true
# TrovaPrezzi: Italian price-comparison pages (IT market only).
TROVAPREZZI_ENABLED=true
# DuckDuckGo: free HTML-endpoint SERP fallback (politely rate-limited).
DUCKDUCKGO_ENABLED=true
DUCKDUCKGO_RATE_LIMIT_SECONDS=2.0

# --------------------------------------------------------------------------- #
# PDP verification (opt-in: CLI --verify-pdp). Visits pages to confirm IDs and
# read the real price/shipping/stock (regex -> JSON-LD -> AI, cheapest first).
# --------------------------------------------------------------------------- #
PDP_FETCH_TIMEOUT_SECONDS=10.0
PDP_MAX_CONCURRENT_FETCHES=8
PDP_RATE_LIMIT_PER_DOMAIN_SECONDS=1.0
PDP_AI_EXTRACTION_ENABLED=true
PDP_AI_CONFIDENCE_THRESHOLD=0.75
# Optional JS-rendering fallback. Requires: uv sync --extra playwright
#   && playwright install chromium
PDP_PLAYWRIGHT_ENABLED=false

# Logging
LOG_LEVEL=INFO
