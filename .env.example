# AI Quality Gate
GROQ_API_KEY=gsk_xxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Matching thresholds
EXACT_ID_MIN_CONFIDENCE=0.95
SKU_BRAND_MIN_CONFIDENCE=0.80
SEMANTIC_MIN_CONFIDENCE=0.60
AI_GATE_MIN_CONFIDENCE=0.75

# Embedding model (runs locally on CPU — ~90MB download on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --------------------------------------------------------------------------- #
# Source fetching (opt-in: CLI --fetch). Discovers more competitor URLs.
# --------------------------------------------------------------------------- #
# SearXNG is the primary, free, self-hosted metasearch provider. Start the
# bundled instance (config in searxng/settings.yml, JSON API enabled) with:
#   docker compose up -d
# then keep the base URL below (leave empty to disable SearXNG).
SEARXNG_BASE_URL=http://localhost:8888
SEARXNG_ENABLED=true
# How many result pages to fetch per SearXNG query (breadth vs. politeness).
SEARXNG_MAX_PAGES=3
# Bound in-flight requests + space them so upstream engines (Google/Bing/...)
# don't trip CAPTCHAs on large or repeated runs.
SEARXNG_MAX_CONCURRENCY=4
SEARXNG_RATE_LIMIT_SECONDS=0.5
# TrovaPrezzi: Italian price-comparison pages (IT market only).
TROVAPREZZI_ENABLED=true
# DuckDuckGo: free HTML-endpoint SERP fallback (politely rate-limited).
DUCKDUCKGO_ENABLED=true
DUCKDUCKGO_RATE_LIMIT_SECONDS=1.0

# --------------------------------------------------------------------------- #
# PDP verification. With --fetch, real price/stock are read from each discovered
# offer's page by default (regex -> JSON-LD -> AI, cheapest first). Set
# FETCH_READ_PRICES=false to make --fetch discovery-only (URLs, no prices).
# --verify-pdp forces the same page verification even without --fetch.
# --------------------------------------------------------------------------- #
FETCH_READ_PRICES=true
PDP_FETCH_TIMEOUT_SECONDS=20.0
PDP_MAX_CONCURRENT_FETCHES=8
PDP_RATE_LIMIT_PER_DOMAIN_SECONDS=1.0
PDP_AI_EXTRACTION_ENABLED=true
PDP_AI_CONFIDENCE_THRESHOLD=0.75
# JS-rendering fallback for Cloudflare/JS-heavy shops. Requires:
#   uv sync --extra playwright && uv run playwright install chromium
PDP_PLAYWRIGHT_ENABLED=true

# Logging
LOG_LEVEL=INFO
